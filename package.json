{
  "name": "axiom-lumen",
  "version": "0.1.0",
  "private": true,
  "description": "A data verification and reconciliation layer for fragmented Stellar ecosystem data.",
  "bugs": {
    "url": "https://github.com/Axiom-Lumen/axiom-lumen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Axiom-Lumen/axiom-lumen.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "openapi:generate": "tsx scripts/openapi.ts --write",
    "openapi:check": "tsx scripts/openapi.ts",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "anchor:discover": "tsx scripts/discover-anchor.ts",
    "anchor:rotate-contact-secret": "tsx scripts/rotate-anchor-contact-secret.ts",
    "anchor:review-case": "tsx scripts/review-anchor-case.ts",
    "anchor:requeue-notification": "tsx scripts/requeue-anchor-notification.ts",
    "anchor:request-claim": "tsx scripts/request-anchor-claim.ts",
    "anchor:verify-claim": "tsx scripts/verify-anchor-claim.ts",
    "anchor:register-contact": "tsx scripts/register-anchor-contact.ts",
    "anchor:revoke-contact": "tsx scripts/revoke-anchor-contact.ts",
    "anchor:revoke-session": "tsx scripts/revoke-anchor-session.ts",
    "anchor:submit-reply": "tsx scripts/submit-anchor-reply.ts",
    "anchor:submit-dispute": "tsx scripts/submit-anchor-dispute.ts",
    "anchor:review-disputes": "tsx scripts/review-anchor-disputes.ts",
    "anchor:resolve-dispute": "tsx scripts/resolve-anchor-dispute.ts",
    "anchor:correct-flag": "tsx scripts/correct-anchor-flag.ts",
    "api:key-create": "tsx scripts/create-api-key.ts",
    "api:key-rotate": "tsx scripts/rotate-api-key.ts",
    "api:key-revoke": "tsx scripts/revoke-api-key.ts",
    "api:quota-prune": "tsx scripts/prune-api-quota.ts",
    "ops:backup": "tsx scripts/backup-database.ts",
    "ops:backup-check": "tsx scripts/check-database-backup.ts",
    "ops:restore-drill": "tsx scripts/restore-database-drill.ts",
    "security:secrets": "git ls-files --cached --others --exclude-standard -z | node scripts/check-secrets.mjs",
    "security:dependencies": "npm audit --audit-level=high",
    "smoke:horizon": "tsx scripts/horizon-smoke.ts",
    "release:manifest-create": "tsx scripts/release/create-manifest.ts",
    "release:manifest-verify": "tsx scripts/release/verify-manifest.ts",
    "release:render-kubernetes": "tsx scripts/release/render-kubernetes.ts",
    "release:smoke": "tsx scripts/release/smoke.ts",
    "release:readiness-verify": "tsx scripts/release/verify-readiness.ts",
    "worker:once": "tsx worker/main.ts --once",
    "worker:continuous": "tsx worker/main.ts --continuous",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:quality": "vitest run tests/quality",
    "test:database": "vitest run tests/database --testTimeout 15000",
    "test:database:ci": "node scripts/require-database-test-env.mjs && npm run test:database",
    "ci": "npm run lint && npm run typecheck && npm run openapi:check && npm run security:secrets && npm test && npm run test:integration && npm run test:quality && npm run test:database:ci && npm run db:check && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "pdfjs-dist": "^5.4.624",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "smol-toml": "^1.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "fast-check": "^4.9.0",
    "postcss": "^8.5",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "5.7.3",
    "vitest": "^4.1.10",
    "zod-to-json-schema": "^3.25.2"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "overrides": {
    "hono": "4.13.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.0"
    }
  }
}
