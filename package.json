{
  "name": "axiom-lumen",
  "version": "0.1.0",
  "private": true,
  "description": "A data verification and reconciliation layer for fragmented Stellar ecosystem data.",
  "bugs": {
    "url": "https://github.com/Axiom-Lumen/axiom-lumen/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Axiom-Lumen/axiom-lumen.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "worker:once": "tsx worker/main.ts --once",
    "worker:continuous": "tsx worker/main.ts --continuous",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:database": "vitest run tests/database",
    "ci": "npm run lint && npm run typecheck && npm test && npm run test:integration && npm run db:check && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "fast-check": "^4.9.0",
    "postcss": "^8.5",
    "shadcn": "^4.8.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "5.7.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "overrides": {
    "hono": "4.13.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.0"
    }
  }
}
