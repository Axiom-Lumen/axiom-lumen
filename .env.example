NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated Stellar Horizon base URLs.
# Every endpoint must serve the Stellar Public Network.
# Testnet, futurenet, standalone, and network-mismatched endpoints are excluded.
# At least one endpoint is required by the latest-ledger API route.
# Whitespace is trimmed; duplicate endpoints are ignored.
STELLAR_HORIZON_URLS=https://horizon.stellar.org

# Optional comma-separated hostname policy. When an allow list is present, every configured endpoint hostname
# must appear in it. The deny list always wins. Credentials and local/private literal hosts are always rejected.
# STELLAR_HORIZON_ALLOWED_HOSTS=horizon.stellar.org
# STELLAR_HORIZON_DENIED_HOSTS=untrusted.example

# PostgreSQL runtime and explicit migration connections. Use managed secrets outside local development.
DATABASE_URL=postgresql://axiom:axiom@127.0.0.1:55432/axiom_lumen
DATABASE_MIGRATION_URL=postgresql://axiom:axiom@127.0.0.1:55432/axiom_lumen
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
