NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical CODE:ISSUER shown by the server-rendered confidence artifact and homepage strip. Defaults to Public Network USDC.
# AXIOM_DEFAULT_ASSET=USDC:GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Horizon sources are registered in PostgreSQL source_definitions (see docs/worker.md).
# Optional comma-separated hostname policy. When an allow list is present, every discovered endpoint hostname
# must appear in it. The deny list always wins. Credentials and local/private literal hosts are always rejected.
# STELLAR_HORIZON_ALLOWED_HOSTS=horizon.stellar.org
# STELLAR_HORIZON_DENIED_HOSTS=untrusted.example

# PostgreSQL runtime and explicit migration connections. Use managed secrets outside local development.
DATABASE_URL=postgresql://axiom:axiom@127.0.0.1:55432/axiom_lumen
DATABASE_MIGRATION_URL=postgresql://axiom:axiom@127.0.0.1:55432/axiom_lumen
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Hosted API access. Anonymous local/self-hosted reads remain enabled unless this is explicitly true.
# Provision plans/principals in PostgreSQL, then use npm run api:key-create; never commit plaintext keys.
AXIOM_API_AUTH_REQUIRED=false
# Required by server-rendered first-party snapshot components when authentication is enabled.
# AXIOM_SITE_API_KEY=axl_live_store-in-a-secret-manager
# Completed quota windows are operational state, not permanent audit evidence. Run api:quota-prune on a schedule.
API_QUOTA_RETENTION_HOURS=168

# Idempotent ingestion worker. WORKER_ID defaults to hostname:pid when omitted.
# WORKER_ID=local-worker-1
INGEST_INTERVAL_SECONDS=60
WORKER_CONCURRENCY=4
WORKER_LEASE_DURATION_MS=30000
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_MS=5000

# Per-source resilience. SOURCE_CONCURRENCY is independent of the job-level WORKER_CONCURRENCY above.
SOURCE_RETRY_MAX_ATTEMPTS=3
SOURCE_RETRY_BASE_DELAY_MS=250
SOURCE_RETRY_MAX_DELAY_MS=5000
SOURCE_RETRY_JITTER_RATIO=0.2
SOURCE_CONCURRENCY=4
SOURCE_CIRCUIT_FAILURE_THRESHOLD=3
SOURCE_CIRCUIT_COOLDOWN_MS=60000
HORIZON_TIMEOUT_MS=5000
HORIZON_MAX_RESPONSE_BYTES=1000000

# Internal ANC-03 right-of-reply worker. Keep disabled until contacts, relay credentials, and operational
# ownership are configured. Publication remains separately disabled by default.
ANCHOR_WORKFLOW_ENABLED=false
ANCHOR_NOTIFICATION_CONCURRENCY=2
ANCHOR_NOTIFICATION_CLAIM_LIMIT=10
ANCHOR_NOTIFICATION_LEASE_DURATION_MS=30000
ANCHOR_WORKFLOW_POLL_INTERVAL_MS=5000
ANCHOR_NOTIFICATION_MAX_ATTEMPTS=5
ANCHOR_NOTIFICATION_RETRY_BASE_DELAY_MS=1000
ANCHOR_NOTIFICATION_RETRY_MAX_DELAY_MS=300000
ANCHOR_NOTIFICATION_TIMEOUT_MS=10000
ANCHOR_NOTIFICATION_MAX_RESPONSE_BYTES=64000
# Required only for verified email contacts. Both values must be configured together.
# ANCHOR_EMAIL_RELAY_URL=https://mail-relay.example/v1/send
# ANCHOR_EMAIL_RELAY_TOKEN=managed-secret
# AES-256-GCM keyring for encrypted webhook signing secrets: key-id:canonical-base64-32-byte-key.
# Retain prior keys until every stored secret version has been rotated away from them.
# ANCHOR_CONTACT_SECRET_KEYS=2026-08:base64-key,2026-07:prior-base64-key
# ANCHOR_CONTACT_ACTIVE_KEY_ID=2026-08
# Claimant evidence uploads require ClamAV and a private content-addressed storage directory.
# ANCHOR_EVIDENCE_SCANNER_EXECUTABLE=clamscan
# ANCHOR_EVIDENCE_STORAGE_DIRECTORY=/var/lib/axiom-lumen/anchor-evidence
# Set only after the product/legal approval required by ADR 0001 is recorded.
ANCHOR_NAMED_PARTY_PUBLICATION_ENABLED=false
