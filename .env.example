NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical CODE:ISSUER shown by the server-rendered confidence artifact and homepage strip. Defaults to Public Network USDC.
# AXIOM_DEFAULT_ASSET=USDC:GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Horizon sources are registered in PostgreSQL source_definitions (see docs/worker.md).
# Optional comma-separated hostname policy. When an allow list is present, every discovered endpoint hostname
# must appear in it. The deny list always wins. Credentials and local/private literal hosts are always rejected.
# STELLAR_HORIZON_ALLOWED_HOSTS=horizon.stellar.org
# STELLAR_HORIZON_DENIED_HOSTS=untrusted.example

# PostgreSQL runtime and explicit migration connections. Use managed secrets outside local development.
DATABASE_URL=postgresql://axiom:axiom@127.0.0.1:55432/axiom_lumen
DATABASE_MIGRATION_URL=postgresql://axiom:axiom@127.0.0.1:55432/axiom_lumen
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Idempotent ingestion worker. WORKER_ID defaults to hostname:pid when omitted.
# WORKER_ID=local-worker-1
INGEST_INTERVAL_SECONDS=60
WORKER_CONCURRENCY=4
WORKER_LEASE_DURATION_MS=30000
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL_MS=5000

# Per-source resilience. SOURCE_CONCURRENCY is independent of the job-level WORKER_CONCURRENCY above.
SOURCE_RETRY_MAX_ATTEMPTS=3
SOURCE_RETRY_BASE_DELAY_MS=250
SOURCE_RETRY_MAX_DELAY_MS=5000
SOURCE_RETRY_JITTER_RATIO=0.2
SOURCE_CONCURRENCY=4
SOURCE_CIRCUIT_FAILURE_THRESHOLD=3
SOURCE_CIRCUIT_COOLDOWN_MS=60000
HORIZON_TIMEOUT_MS=5000
HORIZON_MAX_RESPONSE_BYTES=1000000
